# Makefile_591 - build with:  make -f Makefile_591
CC      = gcc
CFLAGS  = -Wall -Wextra -std=gnu11 -O2 -pthread

all: agent_591 controller_591

agent_591: agent_591.c
	$(CC) $(CFLAGS) -o $@ $<

controller_591: controller_591.c
	$(CC) $(CFLAGS) -o $@ $<

clean:
	rm -f agent_591 controller_591

.PHONY: all clean
